<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃天气 v1.5：静态紧凑排版（无动画），保证 2 格高度内数据完整 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- 头部：图标 / 温度+状况 / 城市日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_emoji"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:textSize="33sp"
            android:text="⛅"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="2dp">

            <TextView
                android:id="@+id/tv_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="@color/temp_text"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.0" />

            <TextView
                android:id="@+id/tv_cond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载中…"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="河源市"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--月--日"
                android:textColor="@color/dim_text"
                android:textSize="9.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#14FFFFFF" />

    <!-- 统计单行：最高 / 最低 / 湿度 / 风力 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最高 --°"
            android:textColor="@color/primary_text"
            android:textSize="11.5sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_lo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最低 --°"
            android:textColor="@color/primary_text"
            android:textSize="11.5sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_humidity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="湿度 --"
            android:textColor="@color/primary_text"
            android:textSize="11.5sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="风 --"
            android:textColor="@color/primary_text"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:gravity="end" />
    </LinearLayout>

    <!-- 今夜 / 明天 预报 -->
    <TextView
        android:id="@+id/tv_forecast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/forecast_bg"
        android:text="今夜 --"
        android:textColor="#D4E0F0"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- 底部：数据时间 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="数据 --:--"
            android:textColor="@color/dim_text"
            android:textSize="9.5sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ 刷新"
            android:textColor="@color/accent_text"
            android:textSize="10.5sp"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
